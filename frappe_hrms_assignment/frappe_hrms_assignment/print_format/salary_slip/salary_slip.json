 "html": "<style>\n    @page {\n        size: A4;\n        margin: 15mm;\n    }\n\n    body {\n        font-family: Arial, sans-serif;\n        font-size: 12px;\n        color: #333;\n    }\n\n    .container {\n        width: 100%;\n    }\n\n    .header {\n        border-bottom: 2px solid #2c3e50;\n        padding-bottom: 10px;\n        margin-bottom: 10px;\n    }\n\n    .header table {\n        width: 100%;\n    }\n\n    .logo {\n        width: 70px;\n    }\n\n    .company-name {\n        font-size: 18px;\n        font-weight: bold;\n        color: #2c3e50;\n    }\n\n    .title {\n        text-align: center;\n        font-size: 20px;\n        font-weight: bold;\n        background: #2c3e50;\n        color: white;\n        padding: 6px;\n        margin-top: 10px;\n        margin-bottom: 15px;\n    }\n\n    .section-title {\n        font-weight: bold;\n        color: #2c3e50;\n        margin-top: 10px;\n        margin-bottom: 5px;\n        border-bottom: 1px solid #ccc;\n        padding-bottom: 3px;\n    }\n\n    table {\n        width: 100%;\n        border-collapse: collapse;\n    }\n\n    td, th {\n        padding: 6px;\n        border: 1px solid #ddd;\n    }\n\n    th {\n        background: #ecf0f1;\n        color: #2c3e50;\n    }\n\n    .no-border td {\n        border: none;\n        padding: 4px;\n    }\n\n    .highlight {\n        background: #f8f9fa;\n        font-weight: bold;\n    }\n\n    .net-pay {\n        background: #27ae60;\n        color: white;\n        font-size: 14px;\n        font-weight: bold;\n    }\n\n    .text-right {\n        text-align: right;\n    }\n\n    .footer {\n        margin-top: 20px;\n    }\n</style>\n\n<div class=\"container\">\n\n    <!-- Header -->\n    <div class=\"header\">\n        <table class=\"no-border\">\n            <tr>\n                <td width=\"80\">\n                    <img src=\"/files/1688187270290.jpeg\" class=\"logo\">\n                </td>\n                <td>\n                    <div class=\"company-name\">{{ doc.company }}</div>\n                    <div>Salary Slip: {{ doc.start_date }} to {{ doc.end_date }}</div>\n                </td>\n            </tr>\n        </table>\n    </div>\n\n    <!-- Title -->\n    <div class=\"title\">Salary Slip</div>\n\n    <!-- Employee Details -->\n    <div class=\"section-title\">Employee Details</div>\n    <table class=\"no-border\">\n        <tr>\n            <td><b>Employee ID:</b> {{ doc.employee }}</td>\n            <td><b>Name:</b> {{ doc.employee_name }}</td>\n        </tr>\n        <tr>\n            <td><b>Department:</b> {{ doc.department or \"-\" }}</td>\n            <td><b>Designation:</b> {{ doc.designation or \"-\" }}</td>\n        </tr>\n    </table>\n\n    <!-- Earnings & Deductions -->\n    <div class=\"section-title\">Earnings & Deductions</div>\n    <table>\n        <tr>\n            <th>Earnings</th>\n            <th class=\"text-right\">Amount</th>\n            <th>Deductions</th>\n            <th class=\"text-right\">Amount</th>\n        </tr>\n\n        {% set max_len = [doc.earnings|length, doc.deductions|length]|max %}\n\n        {% for i in range(max_len) %}\n        <tr>\n            <td>{{ doc.earnings[i].salary_component if doc.earnings|length > i else \"\" }}</td>\n            <td class=\"text-right\">\n                {{ doc.earnings[i].amount if doc.earnings|length > i else \"\" }}\n            </td>\n\n            <td>{{ doc.deductions[i].salary_component if doc.deductions|length > i else \"\" }}</td>\n            <td class=\"text-right\">\n                {{ doc.deductions[i].amount if doc.deductions|length > i else \"\" }}\n            </td>\n        </tr>\n        {% endfor %}\n\n        <tr class=\"highlight\">\n            <td>Total Earnings</td>\n            <td class=\"text-right\">{{ doc.gross_pay }}</td>\n            <td>Total Deductions</td>\n            <td class=\"text-right\">{{ doc.total_deduction }}</td>\n        </tr>\n    </table>\n\n    <!-- Net Pay -->\n    <table style=\"margin-top:10px;\">\n        <tr class=\"net-pay\">\n            <td>Net Pay</td>\n            <td class=\"text-right\">{{ doc.net_pay }}</td>\n        </tr>\n    </table>\n\n    <!-- Footer -->\n    <div class=\"footer\">\n        <table class=\"no-border\">\n            <tr>\n                <td><b>Payment Date:</b> {{ doc.posting_date }}</td>\n                <td class=\"text-right\"><b>Authorized Signatory</b></td>\n            </tr>\n        </table>\n    </div>\n\n</div>",
